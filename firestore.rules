rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSharedStreakMember() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    function isSharedStreakMemberAfterWrite() {
      return signedIn() && request.auth.uid in request.resource.data.memberIds;
    }

    function validSharedStreakStatus() {
      return request.resource.data.status in ['Pending', 'Active', 'Declined'];
    }

    function hasTwoSharedStreakMembers() {
      return request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2;
    }

    function sharedStreakMembersDoNotChange() {
      return request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.memberNames == resource.data.memberNames
        && request.resource.data.invitedByUid == resource.data.invitedByUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validQuestStatus() {
      return request.resource.data.status in ['Available', 'Active', 'Completed', 'Skipped'];
    }

    function validQuestStateShape(questStateId) {
      return request.resource.data.keys().hasOnly([
          'questStateId',
          'questId',
          'date',
          'status',
          'isDailyAssigned',
          'startedAt',
          'completedAt',
          'skippedAt',
          'currentProgress',
          'targetProgress',
          'progressUnit',
          'lastProgressUpdatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'questStateId',
          'questId',
          'date',
          'status',
          'isDailyAssigned',
          'startedAt',
          'completedAt',
          'skippedAt',
          'currentProgress',
          'targetProgress',
          'progressUnit',
          'lastProgressUpdatedAt'
        ])
        && request.resource.data.questStateId is string
        && request.resource.data.questStateId == questStateId
        && request.resource.data.questId is string
        && request.resource.data.questId.size() > 0
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && validQuestStatus()
        && request.resource.data.isDailyAssigned is bool
        && request.resource.data.currentProgress is int
        && request.resource.data.currentProgress >= 0
        && request.resource.data.targetProgress is int
        && request.resource.data.targetProgress >= 1
        && request.resource.data.currentProgress <= request.resource.data.targetProgress
        && request.resource.data.progressUnit is string
        && request.resource.data.progressUnit.size() > 0
        && (request.resource.data.startedAt is int || request.resource.data.startedAt == null)
        && (request.resource.data.completedAt is int || request.resource.data.completedAt == null)
        && (request.resource.data.skippedAt is int || request.resource.data.skippedAt == null)
        && (request.resource.data.lastProgressUpdatedAt is int || request.resource.data.lastProgressUpdatedAt == null);
    }

    match /users/{userId} {
      allow get: if signedIn();

      allow create: if isSelf(userId)
        && request.resource.data.uid == userId;

      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isSelf(userId);

      match /questStates/{questStateId} {
        allow get, list, delete: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && validQuestStateShape(questStateId);
      }

      match /journalEntries/{journalEntryId} {
        allow get, list, create, update, delete: if isSelf(userId);
      }

      match /questFeedback/{feedbackId} {
        allow get, list, create, update, delete: if isSelf(userId);
      }
    }

    match /sharedStreaks/{streakId} {
      allow get, list: if isSharedStreakMember();

      allow create: if signedIn()
        && request.resource.data.id == streakId
        && request.resource.data.invitedByUid == request.auth.uid
        && hasTwoSharedStreakMembers()
        && isSharedStreakMemberAfterWrite()
        && validSharedStreakStatus()
        && request.resource.data.status == 'Pending';

      allow update: if isSharedStreakMember()
        && isSharedStreakMemberAfterWrite()
        && hasTwoSharedStreakMembers()
        && sharedStreakMembersDoNotChange()
        && validSharedStreakStatus();

      // A member may delete the shared streak, e.g. when deleting their account.
      allow delete: if isSharedStreakMember();
    }

    match /quests/{questId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    // FEEDBACK: any signed-in user can submit. No general client reads, but the
    // author may list and delete their own entries (needed for account deletion).
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow list, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow get, update: if false;
    }

    // QUEST SUGGESTIONS: same policy as feedback — author may clean up their own.
    match /quest_suggestions/{suggestionId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow list, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow get, update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
